<idea-plugin>
    <id>io.github.driflux.jnote</id>
    <name>JNote</name>
    <vendor>Driflux</vendor>
    <description><![CDATA[
        A lightweight personal code-note plugin. Attach notes to code, search them, and keep them local.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable parentId="tools"
                                 id="io.github.driflux.jnote.settings"
                                 instance="io.github.driflux.jnote.settings.JNoteConfigurable"
                                 bundle="messages.JNoteBundle"
                                 key="settings.displayName"/>
        <notificationGroup id="JNote"
                           displayType="BALLOON"
                           bundle="messages.JNoteBundle"
                           key="notification.group.name"/>
    </extensions>
</idea-plugin>
