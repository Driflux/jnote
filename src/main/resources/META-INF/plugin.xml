<idea-plugin>
    <id>io.github.driflux.jnote</id>
    <name>JNote</name>
    <vendor>Driflux</vendor>
    <description><![CDATA[
        A lightweight personal code-note plugin. Attach notes to code, search them, and keep them local.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.JNoteBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable parentId="tools"
                                 id="io.github.driflux.jnote.settings"
                                 instance="io.github.driflux.jnote.settings.JNoteConfigurable"
                                 bundle="messages.JNoteBundle"
                                 key="settings.displayName"/>
        <notificationGroup id="JNote"
                           displayType="BALLOON"
                           bundle="messages.JNoteBundle"
                           key="notification.group.name"/>
        <notificationGroup id="JNote.PositionSave"
                           displayType="BALLOON"
                           bundle="messages.JNoteBundle"
                           key="notification.group.positionSave.name"/>

        <toolWindow id="JNote"
                    anchor="right"
                    icon="/icons/toolWindowNote.svg"
                    doNotActivateOnStart="true"
                    factoryClass="io.github.driflux.jnote.ui.JNoteToolWindowFactory"/>

        <!-- language=""는 모든 언어(Language.ANY)를 뜻한다 -->
        <codeInsight.lineMarkerProvider language=""
                                        implementationClass="io.github.driflux.jnote.gutter.NoteLineMarkerProvider"/>
    </extensions>

    <actions>
        <action id="JNote.AddNote" class="io.github.driflux.jnote.action.AddNoteAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt N"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="ctrl alt N"/>
        </action>

        <action id="JNote.RelocateNotes" class="io.github.driflux.jnote.action.RelocateNotesAction">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="JNote.AddNote"/>
        </action>

        <action id="JNote.NewFreeNote" class="io.github.driflux.jnote.action.NewFreeNoteAction"/>

        <group id="JNote.ToolsMenu" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="JNote.ExportAllNotes" class="io.github.driflux.jnote.ai.ExportAllNotesAction"/>
            <action id="JNote.ExportSelectedNotes" class="io.github.driflux.jnote.ai.ExportSelectedNotesAction"/>
            <separator/>
            <action id="JNote.ImportFromFile" class="io.github.driflux.jnote.ai.ImportFromFileAction"/>
            <action id="JNote.ImportFromClipboard" class="io.github.driflux.jnote.ai.ImportFromClipboardAction"/>
        </group>
    </actions>
</idea-plugin>
